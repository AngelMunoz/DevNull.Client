[Desktop Entry]
Type=Application
Name=/dev/null
GenericName=Desktop Client
Comment=Unofficial desktop client for dev-null.sh
Exec=DevNull.Client %u
Icon=me.tunaxor.devnull.unoffclient
Terminal=false
Categories=Network;InstantMessaging;
MimeType=x-scheme-handler/devnull;
StartupWMClass=DevNull.Client
StartupNotify=true
