<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Central package versions; reference from the projects only what
         each one uses, the versions live here alone -->
    <!-- UI: Avalonia 12 + NXUI -->
    <!-- 12.0.5: the version Navs.Avalonia 2.0.1 and MVUish.Avalonia 2.0.0
         are verified against; NXUI 12.0.0 ships 12.0.0 satellite packages,
         so a higher core mixes versions -->
    <PackageVersion Include="Avalonia" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageVersion Include="Avalonia.Headless" Version="12.0.5" />
    <PackageVersion Include="NXUI" Version="12.0.0" />
    <PackageVersion Include="NXUI.Desktop" Version="12.0.0" />
    <!-- 2.0.1: the version Briple.Trainer verifies against Avalonia 12.0.5;
         sources live at E:\Navs and E:\MVUish.Avalonia -->
    <PackageVersion Include="Navs.Avalonia" Version="2.0.1" />
    <PackageVersion Include="MVUish.Avalonia" Version="2.0.0" />

    <!-- Tests -->
    <PackageVersion Include="Expecto" Version="11.1.1" />

    <!-- Core utilities -->
    <PackageVersion Include="FSharp.UMX" Version="1.1.0" />
    <PackageVersion Include="FsToolkit.ErrorHandling" Version="5.2.0" />
    <PackageVersion Include="IcedTasks" Version="0.11.9" />
    <PackageVersion Include="JDeck" Version="1.1.0" />

    <!-- Logging -->
    <PackageVersion Include="Serilog" Version="4.3.1" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />

    <!-- Build: the version of every assembly follows CHANGELOG.md -->
    <PackageVersion Include="Ionide.KeepAChangelog.Tasks" Version="0.3.3" />
  </ItemGroup>
</Project>
