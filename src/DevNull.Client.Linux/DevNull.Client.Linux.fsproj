<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <!-- The shipped executable keeps the product name: the scheme
         handlers of existing installs point at it -->
    <AssemblyName>DevNull.Client</AssemblyName>
    <Nullable>enable</Nullable>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Registrar.fsi" />
    <Compile Include="Registrar.fs" />
    <Compile Include="GStreamer.fsi" />
    <Compile Include="GStreamer.fs" />
    <Compile Include="Audio.fsi" />
    <Compile Include="Audio.fs" />
    <Compile Include="Natives.fsi" />
    <Compile Include="Natives.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="IcedTasks" />
    <!-- The assembly version follows CHANGELOG.md, like Core's -->
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevNull.Client.UI\DevNull.Client.UI.fsproj" />
  </ItemGroup>

</Project>
