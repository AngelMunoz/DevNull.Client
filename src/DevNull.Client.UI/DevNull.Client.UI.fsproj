    <Compile Include="Views\SignInView.fs" />
    <Compile Include="Views\LogView.fsi" />
    <Compile Include="Views\LogView.fs" />
    <Compile Include="Views\CommitDetailView.fsi" />
    <Compile Include="Views\CommitDetailView.fs" />
