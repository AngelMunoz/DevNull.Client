    <Compile Include="Unread.fs" />
    <Compile Include="Timeline.fsi" />
    <Compile Include="Timeline.fs" />
    <Compile Include="Search.fsi" />
    <Compile Include="Search.fs" />
    <Compile Include="RouteStore.fsi" />
    <Compile Include="RouteStore.fs" />
    <Compile Include="RemotesState.fsi" />
    <Compile Include="RemotesState.fs" />
    <Compile Include="Remotes.fsi" />
    <Compile Include="Remotes.fs" />
    <Compile Include="Env.fsi" />
    <Compile Include="Env.fs" />
    <Compile Include="DeviceAuth.fsi" />
    <Compile Include="DeviceAuth.fs" />
    <Compile Include="Navigation.fsi" />
    <Compile Include="Navigation.fs" />
    <Compile Include="Shortcuts.fsi" />
    <Compile Include="Shortcuts.fs" />
