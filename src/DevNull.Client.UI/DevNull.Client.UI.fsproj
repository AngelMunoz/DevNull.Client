    <Compile Include="Startup.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI: Fluent base (as shipped), NXUI for authoring in code,
         Navs for routing, MVUish for the page state loop -->
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="NXUI" />
    <PackageReference Include="Navs.Avalonia" />
    <PackageReference Include="MVUish.Avalonia" />

    <!-- Async: asyncEx binds the Task-based .NET APIs without AwaitTask -->
    <PackageReference Include="IcedTasks" />

    <!-- Processes: the ssh-keygen runs, buffered, bounded, killed on
         the bound -->
    <PackageReference Include="CLIWrap" />

    <!-- Logging: Serilog console + rolling file, bridged for the router -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />

    <!-- The assembly version follows CHANGELOG.md, like Core's -->
    <PackageReference Include="Ionide.KeepAChangelog.Tasks" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DevNull.Client.Core\DevNull.Client.Core.fsproj" />
  </ItemGroup>

</Project>
