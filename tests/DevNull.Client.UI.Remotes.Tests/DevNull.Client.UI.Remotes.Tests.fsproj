<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\DevNull.Client.UI.Tests\Harness.fs" Link="Harness.fs" />
    <Compile Include="..\DevNull.Client.UI.Tests\Fixtures.fs" Link="Fixtures.fs" />
    <Compile Include="..\DevNull.Client.UI.Tests\Leaks.Tests.fs" Link="Leaks.Tests.fs" />
    <Compile Include="Remotes.Tests.fs" />
    <Compile Include="RemotesView.Tests.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="Expecto" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DevNull.Client.UI\DevNull.Client.UI.fsproj" />
  </ItemGroup>

</Project>
